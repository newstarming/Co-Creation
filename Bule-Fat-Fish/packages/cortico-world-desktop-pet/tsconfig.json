{
  // 一份配置同时检查 Node 侧(src/、tests/、scripts/)与 WebUI 面板(src/webui/),
  // 所以 lib 里 DOM 与 ES2022 都在。web/ 是原样下发的浏览器 JS,不在这里检查。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // 开发期把 `cortico/*` 指到主仓库锁定的框架源码。装进宿主运行时不靠它:
    // 那时解析由框架的 `src/extensions/runtime.ts` 注册的模块钩子完成。
    "paths": {
      "cortico/*": ["../../vendor/cortico/src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
